#!/usr/bin/env bash
# post-commit — выполняется после фиксации (на результат коммита не влияет):
# краткая информация о трёх последних изменениях и статический анализ cppcheck.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

C='\033[1;35m'; Y='\033[1;33m'; G='\033[1;32m'; N='\033[0m'
[ -t 1 ] || { C=''; Y=''; G=''; N=''; }
step() { printf "${C}[post-commit]${N} %s\n" "$*"; }

step "последние три изменения:"
git --no-pager log -3 --shortstat --format='  %h  %ad  %an  %s' \
    --date=format:'%Y-%m-%d %H:%M' | sed -e '/^$/d' -e 's/^ \([0-9]\)/           \1/'

# Файлы C++, изменённые в этом коммите (для первого коммита — все файлы)
if git rev-parse -q --verify HEAD~1 >/dev/null; then
    CPP=$(git diff --name-only --diff-filter=ACM HEAD~1 HEAD | grep -E '\.(cpp|h|hpp)$' || true)
else
    CPP=$(git ls-files | grep -E '\.(cpp|h|hpp)$' || true)
fi

if [ -z "$CPP" ]; then
    step "файлы C++ не изменялись — статический анализ не требуется"
    exit 0
fi

REPORT=.git/cppcheck-report.txt
step "cppcheck $(cppcheck --version | cut -d' ' -f2): $(echo $CPP | wc -w) файл(ов)"
# shellcheck disable=SC2086
cppcheck --enable=warning,style,performance,portability --std=c++17 --language=c++ \
         --inline-suppr --quiet -I lib \
         --template='{file}:{line}: {severity}: {message} [{id}]' $CPP 2> "$REPORT"
if [ -s "$REPORT" ]; then
    printf "${Y}[post-commit] cppcheck: замечаний — %d (полный отчёт: %s)${N}\n" "$(wc -l < "$REPORT")" "$REPORT"
    sed 's/^/  /' "$REPORT"
else
    printf "${G}[post-commit] cppcheck: замечаний нет${N}\n"
fi
exit 0
